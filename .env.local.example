# Dashboard Supabase -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Origine publique du site, utilisée pour construire les liens envoyés par mail
# (confirmation d'inscription, réinitialisation de mot de passe). Sans elle,
# l'origine est déduite des en-têtes de la requête — suffisant en local, mais
# à définir en production pour que ces liens ne dépendent pas d'un en-tête Host.
# Lue côté serveur uniquement : pas de préfixe NEXT_PUBLIC_, donc modifiable
# sans reconstruire. À laisser vide en local, sinon les liens de
# réinitialisation demandés depuis le serveur de dev pointeraient vers la prod.
SITE_URL=https://maintenance-velo.vercel.app

# Mot de passe de la base (non utilisé par l'app, conservé pour référence)
SUPABASE_DB_PASSWORD=

# console.anthropic.com -> API Keys (secret serveur, ne jamais exposer au navigateur)
ANTHROPIC_API_KEY=

# true = l'analyse renvoie un texte simule, sans appeler l'API (tests gratuits)
ANTHROPIC_MOCK=

# Tests E2E (npm run test:e2e)
# URL cible des tests (defaut : prod). Pointera vers l'environnement de test plus tard.
E2E_BASE_URL=
# Compte utilise par les tests (les tests ne touchent que des donnees prefixees [TEST])
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# Necessaire uniquement si E2E_BASE_URL pointe vers une URL de deploiement
# protegee par le SSO Vercel (ex: deploiement candidat) : Vercel dashboard ->
# Project Settings -> Deployment Protection -> Protection Bypass for Automation.
VERCEL_AUTOMATION_BYPASS_SECRET=
